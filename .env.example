# ─── Nibblio environment template ───────────────────────────────────────────
# Copy to .env and fill in. NEVER commit a real .env file.

# runtime
NODE_ENV=development

# game server
PORT=2567
# public origin the browser uses to reach the game server (wss:// in production)
PUBLIC_URL=http://localhost:2567
# origin serving the client bundle (CORS allowlist)
CLIENT_URL=http://localhost:5173

# database (postgres)
DATABASE_URL=postgres://nibblio:nibblio_dev_password@localhost:5432/nibblio

# redis
REDIS_URL=redis://localhost:6379

# secrets — generate strong random values for production:
#   openssl rand -hex 32
SESSION_SECRET=change_me_dev_only
JWT_SECRET=change_me_dev_only

# observability (optional)
SENTRY_DSN=
LOG_LEVEL=info

# production only
DOMAIN=example.com
ACME_EMAIL=admin@example.com
