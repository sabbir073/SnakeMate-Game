{
  "name": "nibblio",
  "version": "0.1.0",
  "private": true,
  "description": "Nibblio — original browser-based real-time multiplayer worm arena",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @nibblio/server --filter @nibblio/client dev",
    "dev:server": "pnpm --filter @nibblio/server dev",
    "dev:client": "pnpm --filter @nibblio/client dev",
    "build": "pnpm -r build",
    "test": "pnpm -r --no-bail test",
    "test:e2e": "pnpm --filter @nibblio/client test:e2e",
    "test:load": "pnpm --filter @nibblio/bot test:load",
    "lint": "pnpm -r --no-bail lint",
    "typecheck": "pnpm -r --no-bail typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css,html}\"",
    "asset:build": "pnpm --filter @nibblio/asset-pipeline build-assets",
    "gate": "bash scripts/quality-gate.sh",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "prettier": "^3.6.0",
    "typescript": "^5.9.0"
  },
  "pnpm": {
    "overrides": {
      "@colyseus/greeting-banner": "^2.0.6"
    }
  }
}
