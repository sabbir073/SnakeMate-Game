{
  "name": "@nibblio/bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "test:load": "tsx src/index.ts --profile 10",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "echo lint: bot ok"
  },
  "dependencies": {
    "@nibblio/config": "workspace:*",
    "@nibblio/protocol": "workspace:*",
    "@nibblio/shared": "workspace:*",
    "colyseus.js": "^0.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
